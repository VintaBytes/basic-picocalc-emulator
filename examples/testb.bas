' TESTB - DIAGNOSTICO MMBASIC / PICOCALC
' Mismo archivo para BASIC Linux y PicoCalc real.
' No usa archivos, perifericos ni INPUT.
' Si hay error, anotar ultimo PASO y linea.
'
DIM INTEGER A%(128),B%(128)
OK=0
FAIL=0
PRINT "TESTB 0.2.49"
PRINT "PASO 1: DIM INICIAL OK"
PRINT "PASO 2: BIN2STR DIRECTO"
RAW$=BIN2STR$(INT16,258)
PRINT "LONGITUD=";LEN(RAW$);" ESP=2"
PRINT "BYTE1=";ASC(MID$(RAW$,1,1));" ESP=2"
PRINT "BYTE2=";ASC(MID$(RAW$,2,1));" ESP=1"
PRINT "RETORNO=";STR2BIN(INT16,RAW$);" ESP=258"
PRINT "PASO 3: TESTN SIMPLE"
TESTN "BASE-LEN",LEN(RAW$),2,0
TESTN "BASE-B1",ASC(MID$(RAW$,1,1)),2,0
TESTN "BASE-B2",ASC(MID$(RAW$,2,1)),1,0
TESTN "BASE-RT",STR2BIN(INT16,RAW$),258,0
PRINT "PASO 4: PRUEBAS ANTERIORES"
PRINT "MATEMATICAS"
TESTN "EXP0",EXP(0),1,0.00001
TESTN "EXP1",EXP(1),2.718281828,0.00001
TESTN "EXP-1",EXP(-1),0.367879441,0.00001
TESTN "LOG-EXP",LOG(EXP(2)),2,0.00001
TESTN "ASIN0",ASIN(0),0,0.00001
TESTN "ASIN1",ASIN(1),1.570796327,0.00001
TESTN "ACOS1",ACOS(1),0,0.00001
TESTN "ACOS0",ACOS(0),1.570796327,0.00001
TESTN "ATAN2Q1",ATAN2(1,1),0.7853981634,0.00001
TESTN "ATAN2Q2",ATAN2(1,-1),2.35619449,0.00001
TESTN "ATAN2Q3",ATAN2(-1,-1),-2.35619449,0.00001
TESTN "ATAN2Q4",ATAN2(-1,1),-0.7853981634,0.00001
OPTION ANGLE DEGREES
TESTN "ASIN-D",ASIN(1),90,0.00001
TESTN "ACOS-D",ACOS(0),90,0.00001
TESTN "ATAN2-D",ATAN2(1,1),45,0.00001
OPTION ANGLE RADIANS
TESTN "FIX+",FIX(2.9),2,0
TESTN "FIX-",FIX(-2.9),-2,0
TESTN "CINT-LOW",CINT(2.4),2,0
TESTN "CINT-HIGH",CINT(2.6),3,0
TESTN "CINT+HALF",CINT(2.5),3,0
TESTN "CINT-HALF",CINT(-2.5),-3,0
TESTN "CINT-LOW-",CINT(-2.4),-2,0
TESTN "CINT-HIGH-",CINT(-2.6),-3,0

PRINT "BASES Y CADENAS"
TESTS "HEX",HEX$(255),"FF"
TESTS "HEX-4",HEX$(255,4),"00FF"
TESTS "HEX-NEG",HEX$(-1),"FFFFFFFFFFFFFFFF"
TESTS "BIN",BIN$(10),"1010"
TESTS "BIN-8",BIN$(10,8),"00001010"
TESTS "OCT",OCT$(9),"11"
TESTS "OCT-4",OCT$(9,4),"0011"
TESTN "VAL-TEXTO",VAL("ABC"),0,0
TESTN "VAL-HEX",VAL("&HFF"),255,0
TESTN "VAL-BIN",VAL("&B101010"),42,0
TESTN "VAL-OCT",VAL("&O17"),15,0
TESTS "STRING-CHR",STRING$(3,65),"AAA"
TESTS "STRING-TXT",STRING$(3,"XYZ"),"XXX"

PRINT "PASO 5: BIN2STR DESPUES"
RAW$=BIN2STR$(INT16,258)
PRINT "LONGITUD=";LEN(RAW$);" ESP=2"
PRINT "BYTE1=";ASC(MID$(RAW$,1,1));" ESP=2"
PRINT "BYTE2=";ASC(MID$(RAW$,2,1));" ESP=1"
PRINT "RETORNO=";STR2BIN(INT16,RAW$);" ESP=258"
PRINT "PASO 6: TESTN DESPUES"
TESTN "POST-LEN",LEN(RAW$),2,0
TESTN "POST-B1",ASC(MID$(RAW$,1,1)),2,0
TESTN "POST-B2",ASC(MID$(RAW$,2,1)),1,0
TESTN "POST-RT",STR2BIN(INT16,RAW$),258,0
PRINT "PASO 7: NOMBRE B$"
B$=BIN2STR$(INT16,258)
PRINT "LONGITUD B$=";LEN(B$);" ESP=2"
PRINT "BYTE1 B$=";ASC(MID$(B$,1,1));" ESP=2"
PRINT "BYTE2 B$=";ASC(MID$(B$,2,1));" ESP=1"
PRINT "RETORNO B$=";STR2BIN(INT16,B$);" ESP=258"
PRINT "PASO 8: FINAL"
PRINT "TOTAL TESTN/TESTS=";OK+FAIL
PRINT "OK=";OK;" FAIL=";FAIL
IF FAIL=0 THEN
 PRINT "RESULTADO: PASS"
ELSE
 PRINT "RESULTADO: FAIL"
ENDIF
END

SUB TESTN(N$,V,E,T)
 IF ABS(V-E)<=T THEN
  OK=OK+1
 ELSE
  FAIL=FAIL+1
  PRINT "FAIL ";N$
  PRINT " ESP=";E;" OBT=";V
 ENDIF
END SUB

SUB TESTS(N$,V$,E$)
 IF V$=E$ THEN
  OK=OK+1
 ELSE
  FAIL=FAIL+1
  PRINT "FAIL ";N$
  PRINT " ESP=[";E$;"]"
  PRINT " OBT=[";V$;"]"
 ENDIF
END SUB
