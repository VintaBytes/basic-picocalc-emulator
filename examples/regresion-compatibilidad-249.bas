' REGRESION BASICA PICOCALC 0.2.49
' Ejecutar SIN CAMBIOS en Linux y en PicoCalc real.
' Resultados esperados incluidos en cada prueba.
' No usa perifericos, archivos ni teclado de INPUT.
' No cambiar los valores esperados para ocultar divergencias.
'
OK=0
FAIL=0
PRINT "REGRESION PICOCALC 249"
PRINT "MATEMATICAS"
TESTN "EXP0",EXP(0),1,0.00001
TESTN "EXP1",EXP(1),2.718281828,0.00001
TESTN "EXP-1",EXP(-1),0.367879441,0.00001
TESTN "LOG-EXP",LOG(EXP(2)),2,0.00001
TESTN "ASIN0",ASIN(0),0,0.00001
TESTN "ASIN1",ASIN(1),1.570796327,0.00001
TESTN "ACOS1",ACOS(1),0,0.00001
TESTN "ACOS0",ACOS(0),1.570796327,0.00001
TESTN "ATAN2Q1",ATAN2(1,1),0.7853981634,0.00001
TESTN "ATAN2Q2",ATAN2(1,-1),2.35619449,0.00001
TESTN "ATAN2Q3",ATAN2(-1,-1),-2.35619449,0.00001
TESTN "ATAN2Q4",ATAN2(-1,1),-0.7853981634,0.00001
OPTION ANGLE DEGREES
TESTN "ASIN-D",ASIN(1),90,0.00001
TESTN "ACOS-D",ACOS(0),90,0.00001
TESTN "ATAN2-D",ATAN2(1,1),45,0.00001
OPTION ANGLE RADIANS
TESTN "FIX+",FIX(2.9),2,0
TESTN "FIX-",FIX(-2.9),-2,0
TESTN "CINT-LOW",CINT(2.4),2,0
TESTN "CINT-HIGH",CINT(2.6),3,0
TESTN "CINT+HALF",CINT(2.5),3,0
TESTN "CINT-HALF",CINT(-2.5),-3,0
TESTN "CINT-LOW-",CINT(-2.4),-2,0
TESTN "CINT-HIGH-",CINT(-2.6),-3,0

PRINT "BASES Y CADENAS"
TESTS "HEX",HEX$(255),"FF"
TESTS "HEX-4",HEX$(255,4),"00FF"
TESTS "HEX-NEG",HEX$(-1),"FFFFFFFFFFFFFFFF"
TESTS "BIN",BIN$(10),"1010"
TESTS "BIN-8",BIN$(10,8),"00001010"
TESTS "OCT",OCT$(9),"11"
TESTS "OCT-4",OCT$(9,4),"0011"
TESTN "VAL-TEXTO",VAL("ABC"),0,0
TESTN "VAL-HEX",VAL("&HFF"),255,0
TESTN "VAL-BIN",VAL("&B101010"),42,0
TESTN "VAL-OCT",VAL("&O17"),15,0
TESTS "STRING-CHR",STRING$(3,65),"AAA"
TESTS "STRING-TXT",STRING$(3,"XYZ"),"XXX"

PRINT "CADENAS BINARIAS"
B$=BIN2STR$(INT16,258)
TESTN "INT16-LEN",LEN(B$),2,0
TESTN "INT16-B1",ASC(MID$(B$,1,1)),2,0
TESTN "INT16-B2",ASC(MID$(B$,2,1)),1,0
TESTN "INT16-RT",STR2BIN(INT16,B$),258,0
TESTN "INT16-BIG",STR2BIN(INT16,BIN2STR$(INT16,258,BIG),BIG),258,0
TESTN "INT8-NEG",STR2BIN(INT8,BIN2STR$(INT8,-1)),-1,0
TESTN "UINT8",STR2BIN(UINT8,BIN2STR$(UINT8,255)),255,0
TESTN "INT32-NEG",STR2BIN(INT32,BIN2STR$(INT32,-123456)),-123456,0
TESTN "SINGLE",STR2BIN(SINGLE,BIN2STR$(SINGLE,1.5)),1.5,0.00001
TESTN "DOUBLE",STR2BIN(DOUBLE,BIN2STR$(DOUBLE,3.125)),3.125,0.00001

PRINT "LONGSTRING"
DIM INTEGER A%(128),B%(128)
LONGSTRING LOAD A%(),4,"HOLA"
TESTN "LS-LOAD",LLEN(A%()),4,0
TESTS "LS-STR",LGETSTR$(A%(),1,4),"HOLA"
TESTN "LS-BYTE",LGETBYTE(A%(),1),72,0
LONGSTRING APPEND A%()," Pico"
TESTN "LS-APPEND",LLEN(A%()),9,0
TESTS "LS-APPEND-TXT",LGETSTR$(A%(),1,9),"HOLA Pico"
TESTN "LS-FIND",LINSTR(A%(),"Pico"),6,0
TESTN "LS-NOTFOUND",LINSTR(A%(),"xxx"),0,0
LONGSTRING COPY B%(),A%()
TESTS "LS-COPY",LGETSTR$(B%(),1,9),"HOLA Pico"
LONGSTRING LEFT B%(),A%(),4
TESTS "LS-LEFT",LGETSTR$(B%(),1,4),"HOLA"
LONGSTRING MID B%(),A%(),6,4
TESTS "LS-MID",LGETSTR$(B%(),1,4),"Pico"
LONGSTRING RIGHT B%(),A%(),4
TESTS "LS-RIGHT",LGETSTR$(B%(),1,4),"Pico"
LONGSTRING UCASE B%()
TESTS "LS-UCASE",LGETSTR$(B%(),1,4),"PICO"
LONGSTRING LCASE B%()
TESTS "LS-LCASE",LGETSTR$(B%(),1,4),"pico"
LONGSTRING SETBYTE B%(),1,88
TESTS "LS-SETBYTE",LGETSTR$(B%(),1,4),"Xico"
LONGSTRING RESIZE B%(),2
TESTN "LS-RESIZE",LLEN(B%()),2,0
TESTS "LS-RESIZE-TXT",LGETSTR$(B%(),1,2),"Xi"
LONGSTRING CLEAR B%()
TESTN "LS-CLEAR",LLEN(B%()),0,0
LONGSTRING LOAD B%(),3,"ABC"
TESTN "LS-MEMLEN",B%(0),3,0
TESTN "LS-MEMRAW",B%(1),4407873,0
LONGSTRING CLEAR B%()
LONGSTRING APPEND B%(),STRING$(250,"Q")
LONGSTRING APPEND B%(),STRING$(250,"Z")
TESTN "LS-500",LLEN(B%()),500,0
TESTS "LS-BOUNDARY",LGETSTR$(B%(),249,4),"QQZZ"
LONGSTRING CLEAR B%()
LONGSTRING CONCAT B%(),A%()
TESTS "LS-CONCAT",LGETSTR$(B%(),1,9),"HOLA Pico"

PRINT "JSON"
J$="{""user"":{""name"":""Pico"",""v"":3,""data"":[7,8],""enabled"":true}}"
LONGSTRING LOAD A%(),LEN(J$),J$
TESTS "JSON-NAME",JSON$(A%(),"user.name"),"Pico"
TESTS "JSON-NUM",JSON$(A%(),"user.v"),"3"
TESTS "JSON-INDEX",JSON$(A%(),"user.data[1]"),"8"
TESTS "JSON-BOOL",JSON$(A%(),"user.enabled"),"true"

PRINT "ON ERROR"
ON ERROR CLEAR
TESTN "ERR-CLEAR0",MM.ERRNO,0,0
TESTS "ERR-MSG0",MM.ERRMSG$,""
ON ERROR SKIP 2
X=1/0
Y=1/0
TESTN "ERR-SKIP-SET",MM.ERRNO>0,1,0
TESTN "ERR-SKIP-MSG",LEN(MM.ERRMSG$)>0,1,0
ON ERROR CLEAR
TESTN "ERR-CLEAR1",MM.ERRNO,0,0
TESTS "ERR-MSG1",MM.ERRMSG$,""
ON ERROR IGNORE
X=1/0
TESTN "ERR-IGNORE",MM.ERRNO>0,1,0
ON ERROR CLEAR
TESTN "ERR-IGNORE-CLR",MM.ERRNO,0,0
Y=1/0
TESTN "ERR-IGNORE2",MM.ERRNO>0,1,0
ON ERROR ABORT

PRINT "--------------------------------"
PRINT "TOTAL=";OK+FAIL
PRINT "OK=";OK
PRINT "FAIL=";FAIL
IF FAIL=0 THEN
 PRINT "RESULTADO: PASS"
ELSE
 PRINT "RESULTADO: FAIL"
ENDIF
PRINT "FIN REGRESION"
END

SUB TESTN(N$,V,E,T)
 IF ABS(V-E)<=T THEN
  OK=OK+1
 ELSE
  FAIL=FAIL+1
  PRINT "FAIL ";N$
  PRINT " ESP=";E;" OBT=";V
 ENDIF
END SUB

SUB TESTS(N$,V$,E$)
 IF V$=E$ THEN
  OK=OK+1
 ELSE
  FAIL=FAIL+1
  PRINT "FAIL ";N$
  PRINT " ESP=[";E$;"]"
  PRINT " OBT=[";V$;"]"
 ENDIF
END SUB
