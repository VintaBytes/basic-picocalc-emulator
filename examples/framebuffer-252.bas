' FRAMEBUFFER N/F/L - BASIC CDE Linux 0.2.52
' Probar en PicoCalc 6.0003: comprobar diferencias de colores
' y sintaxis antes de afirmar equivalencia pixel a pixel.
CLS RGB(0,0,0)
FRAMEBUFFER CREATE
FRAMEBUFFER LAYER
FRAMEBUFFER WRITE F
CLS RGB(0,0,32)
BOX 12,12,296,296,1,RGB(0,255,0)
LINE 12,12,307,307,1,RGB(255,0,0)
LINE 307,12,12,307,1,RGB(0,255,0)
CIRCLE 160,160,85,1,1,RGB(255,255,0)
FRAMEBUFFER COPY F,N
PAUSE 800
FRAMEBUFFER WRITE L
CLS RGB(0,0,0)
BOX 80,140,160,40,1,RGB(255,255,255),RGB(0,0,128)
TEXT 160,150,"PicoCalc", "CT",1,1,RGB(255,255,255)
FRAMEBUFFER MERGE RGB(0,0,0)
PAUSE 800
FRAMEBUFFER WRITE N
FRAMEBUFFER CLOSE
END
