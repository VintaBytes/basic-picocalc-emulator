' PicoCalc / BASIC PicoCalc Linux: ON ERROR
' Ejecutar en ambos sistemas y comparar los resultados.
PRINT "PRUEBA ON ERROR 247"
ON ERROR SKIP 2
A=1/0
B=2/0
PRINT "SKIP2 ERRNO=";MM.ERRNO
PRINT "SKIP2 MSG=";LEN(MM.ERRMSG$)>0
ON ERROR CLEAR
PRINT "CLEAR ERRNO=";MM.ERRNO
PRINT "CLEAR MSG=";LEN(MM.ERRMSG$)
ON ERROR IGNORE
C=1/0
PRINT "IGNORE ERRNO=";MM.ERRNO
ON ERROR ABORT
PRINT "FIN"
END
