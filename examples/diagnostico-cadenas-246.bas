' BASIC PicoCalc Linux - pruebas de cadenas y bytes
' Ejecutar en PicoCalc fisica y comparar salida con Linux.
PRINT "DIAGNOSTICO CADENAS 246"
PRINT "VAL TEXTO="; VAL("ABC")
PRINT "VAL HEX="; VAL("&HFF")
PRINT "VAL BIN="; VAL("&B101010")
PRINT "VAL OCT="; VAL("&O17")
PRINT "STRING ASCII="; STRING$(3,65)
PRINT "STRING TEXTO="; STRING$(3,"XYZ")
B$=BIN2STR$(INT16,258)
PRINT "BIN2STR INT16 LONG="; LEN(B$)
PRINT "BYTE1="; ASC(MID$(B$,1,1))
PRINT "BYTE2="; ASC(MID$(B$,2,1))
PRINT "STR2BIN INT16="; STR2BIN(INT16,B$)
PRINT "BIG INT16="; STR2BIN(INT16,BIN2STR$(INT16,258,BIG),BIG)
PRINT "INT8 -1="; STR2BIN(INT8,BIN2STR$(INT8,-1))
PRINT "SINGLE="; STR2BIN(SINGLE,BIN2STR$(SINGLE,1.5))
PRINT "DOUBLE="; STR2BIN(DOUBLE,BIN2STR$(DOUBLE,3.125))
PRINT "FIN DIAGNOSTICO"
END
