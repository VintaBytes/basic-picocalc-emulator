' SPRITE FASE 2 - compatible con la sintaxis PicoMite 6.00.03
' REQUISITO: firmware con soporte SPRITE SHOW (manual: VGA/HDMI).
' PRUEBA Linux: mover sprite, solapar, HIDE SAFE, SWAP.
CLS RGB(12,24,40)
BOX 12,12,32,32,,RGB(255,0,0),RGB(255,0,0)
SPRITE READ #1,12,12,32,32
BOX 12,12,32,32,,RGB(0,255,0),RGB(0,255,0)
SPRITE READ #2,12,12,32,32
BOX 12,12,32,32,,RGB(0,0,255),RGB(0,0,255)
SPRITE READ #3,12,12,32,32
CLS RGB(12,24,40)
TEXT 8,10,"SPRITE SHOW / SAFE / SWAP"
SPRITE SHOW #1,70,80,0
PAUSE 400
SPRITE SHOW #2,85,95,0
PAUSE 400
SPRITE SHOW SAFE #1,110,80,0
PAUSE 400
SPRITE SWAP #1,#3
PAUSE 400
SPRITE HIDE SAFE #2
PAUSE 400
SPRITE HIDE #3
TEXT 8,150,"FONDO RESTAURADO"
SPRITE CLOSE ALL
END
