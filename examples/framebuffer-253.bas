' FRAMEBUFFER 0.2.53 - LCD demo, no keyboard needed
' PicoCalc MMBasic 6.0003 and BASIC CDE Linux
' Test CREATE, WRITE, COPY, LAYER, MERGE 0,B, WAIT.
CLS RGB(0,0,0)
FRAMEBUFFER CREATE
FRAMEBUFFER LAYER
FRAMEBUFFER WRITE F
CLS RGB(0,0,0)
BOX 0,0,320,320,0,0,RGB(0,0,80)
LINE 0,0,319,319,1,RGB(255,255,0)
LINE 319,0,0,319,1,RGB(0,255,255)
FRAMEBUFFER COPY F,N
PAUSE 400
FRAMEBUFFER WRITE L
CLS 0
BOX 80,110,160,70,1,RGB(255,255,255),RGB(0,0,0)
CIRCLE 160,145,28,1,1,RGB(255,0,0)
FRAMEBUFFER MERGE 0,B
FRAMEBUFFER WAIT
PAUSE 800
FRAMEBUFFER WRITE N
FRAMEBUFFER CLOSE
END
